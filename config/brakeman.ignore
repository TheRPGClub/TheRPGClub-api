      "code": "redirect_to((discord_avatar_url or RpgClubUserAvatarHistory.where(:user_id => params[:user_id]).where.not(:avatar_url => ([nil, \"\"])).order(:changed_at => :desc, :event_id => :desc).pick(:avatar_url)), :allow_other_host => true)",
